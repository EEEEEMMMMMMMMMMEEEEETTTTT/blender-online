* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: #0b1220;
  color: #e5eefb;
}

#root {
  min-height: 100vh;
  display: grid;
  place-items: center;
}

.app-shell {
  width: min(680px, 92vw);
}

.panel {
  background: rgba(20, 30, 45, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 18px;
  padding: 2rem;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.5);
}

h1 {
  margin-top: 0;
  margin-bottom: 0.35rem;
  font-size: 2rem;
}

p {
  color: #bfd0ec;
  margin-top: 0;
  margin-bottom: 1.5rem;
}

form {
  display: grid;
  gap: 1rem;
}

.upload-box {
  display: block;
  border: 1px dashed #7dd3fc;
  border-radius: 12px;
  padding: 1.2rem;
  background: rgba(14, 165, 233, 0.08);
  cursor: pointer;
}

.upload-box input {
  display: none;
}

button {
  border: none;
  border-radius: 10px;
  padding: 0.9rem 1.2rem;
  font-size: 1rem;
  font-weight: 600;
  background: linear-gradient(135deg, #22c55e, #14b8a6);
  color: white;
  cursor: pointer;
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.status {
  margin-top: 1rem;
  min-height: 24px;
  color: #dbeafe;
  word-break: break-word;
}

.download-link {
  display: inline-block;
  margin-top: 1rem;
  color: #7dd3fc;
  text-decoration: underline;
}
